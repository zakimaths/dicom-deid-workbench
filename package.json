{
  "name": "dicom-workbench-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/pixels.test.mjs tests/exercise.test.mjs tests/challenge.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "build:preview": "PYTHONPATH=src .venv/bin/python scripts/build_preview.py",
    "test:preview": "node tests/preview.mjs",
    "test:exercise": "node tests/exercise-browser.mjs",
    "test:accessibility": "node tests/challenge-browser.mjs",
    "benchmark:ocr": "node scripts/benchmark_ocr.mjs",
    "sbom": ".venv/bin/python scripts/sbom.py",
    "test:records": "node tests/records-browser.mjs",
    "benchmark:records": "PYTHONPATH=src .venv/bin/python scripts/build_record_corpus.py && PYTHONPATH=src .venv/bin/python scripts/evaluate_records.py --corpus output/records-corpus.json --report output/records-evaluation.json",
    "test:mobile": "node tests/mobile-browser.mjs",
    "test:nifti": "node tests/nifti-browser.mjs && PYTHONPATH=src .venv/bin/python scripts/verify_nifti_exports.py",
    "test:nifti-preview": "node tests/nifti-preview.mjs"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "axe-core": "4.13.0",
    "playwright": "1.62.1",
    "tesseract.js": "7.0.0"
  },
  "version": "0.5.0",
  "dependencies": {
    "@niivue/niivue": "0.69.0"
  }
}
